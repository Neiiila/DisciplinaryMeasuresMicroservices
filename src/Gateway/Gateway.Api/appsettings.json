{
  "Jwt": {
    "Issuer": "DisciplinaryMeasures",
    "Audience": "DisciplinaryMeasuresClient"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "Routes": {
      "authentication": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/authentication/{**catch-all}" }
      },
      "users": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "employees": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/employees/{**catch-all}" }
      },
      "sanction-requests": {
        "ClusterId": "sanctions",
        "Match": { "Path": "/api/sanction-requests/{**catch-all}" }
      },
      "faults": {
        "ClusterId": "sanctions",
        "Match": { "Path": "/api/faults" }
      },
      "notifications": {
        "ClusterId": "notifications",
        "Match": { "Path": "/api/users/me/notifications/{**catch-all}" },
        "Order": -1
      },
      "notifications-root": {
        "ClusterId": "notifications",
        "Match": { "Path": "/api/users/me/notifications" },
        "Order": -1
      },
      "notification-hub": {
        "ClusterId": "notifications",
        "Match": { "Path": "/hubs/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5101/" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Path": "/health/ready"
          }
        }
      },
      "sanctions": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5102/" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Path": "/health/ready"
          }
        }
      },
      "notifications": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5103/" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Path": "/health/ready"
          }
        }
      }
    }
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*"
}
